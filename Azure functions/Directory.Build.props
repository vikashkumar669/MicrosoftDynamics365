<Project>
  <!-- Shared settings for every project in the book's solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Dependency vulnerability advisories are reported, but must not break a reader's build. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Authors>Vikash Kumar</Authors>
    <Product>Harbourline Connect (fictional sample)</Product>
    <Copyright>Copyright (c) 2026 Vikash Kumar</Copyright>
  </PropertyGroup>
</Project>
