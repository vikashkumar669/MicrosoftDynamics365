<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Harbourline.Connect.UnitTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs on Microsoft Testing Platform (opted in via global.json). -->
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Harbourline.Connect.Core\Harbourline.Connect.Core.csproj" />
    <ProjectReference Include="..\..\src\Harbourline.Connect.Contracts\Harbourline.Connect.Contracts.csproj" />
  </ItemGroup>

</Project>
